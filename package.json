{
  "name": "bunkeeper-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "bun lint --no-script",
    "lint:fix": "bun lint --fix --no-script",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "check": "bun fmt --check && bun lint --no-script",
    "web:dev": "bun --cwd apps/web dev",
    "web:build": "bun --cwd apps/web build",
    "web:deploy": "bun --cwd apps/web deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "bun-types": "^1.4.5"
  }
}
